{
  "name": "@shuttle/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server src/index.ts",
    "lint": "echo 'Lint API'",
    "test": "bun test",
    "db:migrate": "bunx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:push": "bunx prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "bunx prisma db seed --schema=./prisma/schema.prisma",
    "db:studio": "bunx prisma studio --schema=./prisma/schema.prisma",
    "db:generate": "bunx prisma generate --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "elysia": "^1.4.29",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@shuttle/types": "workspace:*",
    "ws": "^8.21.3",
    "dotenv": "^17.4.2",
    "@types/bun": "^1.3.14"
  },
  "devDependencies": {
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "tsx": "^4.23.12",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0"
  },
  "prisma": {
    "seed": "bun ../../prisma/seed.ts"
  }
}
